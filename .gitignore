# Training data, checkpoints, and logs. data/ is ~670MB: fixed-width record
# binaries, precomputed legal-move masks, and 67MB checkpoints. Regenerate with
# prepare.py + precompute_masks.py rather than committing any of it.
data/
data_dev/
*.pt
*.pt.final
*.bin
*.log
*.out

__pycache__/
*.pyc
.venv/

node_modules/
.vercel/

# Browser-deploy build artifacts: the ONNX export (regenerate with
# hf/export_onnx.py) and the static Space staging dir (push with hf upload).
hf/onnx/
space/
